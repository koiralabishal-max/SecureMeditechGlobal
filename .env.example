# GEMINI_API_KEY: optional. Enables live AI answers in the procurement chat.
# Without it, /api/chat answers from the built-in domain knowledge.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Canonical site URL used for SEO metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL="https://securemeditechglobal.com"

# Google Search Console HTML tag verification token (the content="" value only).
# Leave empty until verified in Google Search Console.
NEXT_PUBLIC_GSC_VERIFICATION=""

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX).
# Leave empty until created in analytics.google.com.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Google Tag Manager Container ID (format: GTM-XXXXXXX).
# Optional if managing GA4 and conversion tags directly through GTM.
NEXT_PUBLIC_GTM_ID=""

# Optional server-side webhook URL (CRM, Zapier, Slack, or email bridge)
# to receive structured JSON payloads from POST /api/inquiry.
INQUIRY_WEBHOOK_URL=""
